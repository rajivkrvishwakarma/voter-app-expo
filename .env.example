# Production-Grade Expo Environment Variables Template
# Public variables exposed to the client bundle MUST be prefixed with EXPO_PUBLIC_
# NEVER put private API secrets, database passwords, or signing keys here.

# API Base URL (Safe placeholder - points to your backend or local mock server)
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/v1

# App Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development
